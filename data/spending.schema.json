{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASI tax calculator spending data",
  "description": "Written by pipeline/build-spending.mjs from HM Treasury PESA Table 5.2. Amounts in £ million. Checked by validateSpending() in pipeline/pesa.mjs.",
  "type": "object",
  "required": ["meta", "categories"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "url", "publisher", "published", "table", "fiscalYear", "basis", "tes", "accountingAdjustments", "tme", "generated", "taxonomyVersion"],
      "properties": {
        "title": { "type": "string", "description": "Publication title, e.g. Public Expenditure Statistical Analyses 2026" },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "const": "HM Treasury" },
        "published": { "type": "string", "format": "date" },
        "file": { "type": "string", "format": "uri" },
        "fileTitle": { "type": "string" },
        "table": { "type": "string" },
        "fiscalYear": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "basis": { "const": "TES" },
        "units": { "const": "£ million" },
        "tes": { "type": "number" },
        "accountingAdjustments": { "type": "number" },
        "tme": { "type": "number" },
        "generated": { "type": "string", "format": "date-time" },
        "taxonomyVersion": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "amount", "share", "children"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "Chart colour, set in the taxonomy" },
          "description": { "type": "string" },
          "amount": { "type": "number" },
          "share": { "type": "number" },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "amount"],
              "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "amount": { "type": "number" } }
            }
          }
        }
      }
    }
  }
}
